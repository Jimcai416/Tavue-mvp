# Public at runtime. Create a Sentry React Native project before setting this.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=production

# Used by the Worker privacy and support pages. Configure with Wrangler.
SUPPORT_EMAIL=

# Server/local benchmark only. Never expose FATSECRET_CLIENT_SECRET in Expo public env vars.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
